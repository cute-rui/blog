---
import type { GetStaticPaths, Page } from 'astro';
import { siteConfig } from '../../site.config';
import { getPublishedPosts, type Post } from '../../lib/posts';
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  return paginate(await getPublishedPosts(), { pageSize: siteConfig.postsPerPage });
};

type Props = {
  page: Page<Post>;
};

const { page } = Astro.props;
const posts = await getPublishedPosts();
const meta = page.lastPage > 1 ? `共 ${page.total} 篇 · 第 ${page.currentPage} / ${page.lastPage} 页` : `共 ${page.total} 篇`;
---

<SidebarLayout title="文章" description="全部文章列表" posts={posts}>
  <PageHeader kicker="Posts" title="文章" meta={meta} />
  <div class="mt-8 grid gap-4">
    {page.data.map((post) => <PostCard post={post} />)}
  </div>
  <div class="mt-10">
    <Pagination page={page} />
  </div>
</SidebarLayout>
