---
import { getPublishedPosts, groupByYear, postUrl } from '../lib/posts';
import { isoDate, monthDay } from '../lib/date';
import SidebarLayout from '../layouts/SidebarLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const posts = await getPublishedPosts();
const years = groupByYear(posts);
---

<SidebarLayout title="归档" description="按年份浏览全部文章" posts={posts}>
  <PageHeader kicker="Archive" title="归档" meta={`共 ${posts.length} 篇`} />
  {
    years.length === 0 ? (
      <p class="mt-8 text-muted">还没有文章。</p>
    ) : (
      years.map(({ year, posts: yearPosts }) => (
        <section id={`y-${year}`} class="mt-10 scroll-mt-24">
          <h2 class="flex items-baseline gap-4">
            <span class="font-serif text-3xl font-semibold tracking-tight tabular-nums">{year}</span>
            <span class="kicker">{yearPosts.length} 篇</span>
            <span class="h-px flex-1 self-center bg-line" aria-hidden="true" />
          </h2>
          <ol class="mt-3 divide-y divide-line-soft">
            {yearPosts.map((post) => (
              <li>
                <a href={postUrl(post)} class="group flex items-baseline gap-4 py-3 sm:gap-6">
                  <time datetime={isoDate(post.data.pubDate)} class="kicker w-12 shrink-0 tabular-nums">
                    {monthDay(post.data.pubDate)}
                  </time>
                  <span class="min-w-0 font-serif text-lg leading-snug transition-colors group-hover:text-accent">
                    {post.data.title}
                  </span>
                  <span class="ml-auto hidden shrink-0 gap-2 sm:flex">
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span class="kicker">#{tag}</span>
                    ))}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    )
  }
</SidebarLayout>
