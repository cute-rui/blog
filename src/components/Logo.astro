---
type Props = {
  size?: number;
  class?: string;
};

const { size = 40, class: className } = Astro.props;
---

<img
  src="/logo.jpg"
  width={size}
  height={size}
  alt=""
  class:list={['logo-mark', className]}
  style={`--logo-size: ${size}px`}
/>

<style>
  .logo-mark {
    display: block;
    flex: none;
    inline-size: var(--logo-size);
    block-size: var(--logo-size);
    border-radius: calc(var(--logo-size) * 0.18);
    object-fit: cover;
    object-position: center;
    box-shadow: 0 1px 0 rgb(var(--shadow-rgb) / 0.2);
  }
</style>
