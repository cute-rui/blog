---
import { hashString } from '../lib/format';
import type { Post } from '../lib/posts';

type Props = {
  post: Post;
  class?: string;
};

const { post, class: className } = Astro.props;
const seed = hashString(post.id);
const variant = seed % 4;
const glyph = [...post.data.title].find((ch) => /[\p{L}\p{N}]/u.test(ch)) ?? '文';
const label = post.data.tags[0] ?? String(post.data.pubDate.getUTCFullYear());
const gradientId = `cover-g-${seed}`;
const dotsId = `cover-d-${seed}`;
---

<svg
  class={className}
  viewBox="0 0 800 500"
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: var(--surface-2)"></stop>
      <stop offset="1" style="stop-color: var(--accent-soft)"></stop>
    </linearGradient>
    <pattern id={dotsId} width="22" height="22" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.3" style="fill: var(--accent)" opacity="0.4"></circle>
    </pattern>
  </defs>
  <rect width="800" height="500" fill={`url(#${gradientId})`}></rect>
  {
    variant === 0 && (
      <g>
        <g style="stroke: var(--line)" stroke-width="1">
          <line x1="0" y1="140" x2="800" y2="140" />
          <line x1="0" y1="200" x2="800" y2="200" />
          <line x1="0" y1="260" x2="800" y2="260" />
          <line x1="0" y1="320" x2="800" y2="320" />
          <line x1="0" y1="380" x2="800" y2="380" />
        </g>
        <circle cx="620" cy="560" r="300" style="fill: var(--accent)" opacity="0.92" />
        <circle cx="170" cy="150" r="60" style="stroke: var(--accent)" stroke-width="2" fill="none" />
        <circle cx="170" cy="150" r="9" style="fill: var(--accent)" />
      </g>
    )
  }
  {
    variant === 1 && (
      <g>
        <rect x="0" y="0" width="800" height="500" fill={`url(#${dotsId})`} />
        <g transform="rotate(-18 400 250)">
          <rect x="-200" y="200" width="1200" height="34" style="fill: var(--accent)" opacity="0.9" />
          <rect x="-200" y="250" width="1200" height="12" style="fill: var(--accent)" opacity="0.55" />
          <rect x="-200" y="278" width="1200" height="4" style="fill: var(--accent)" opacity="0.35" />
        </g>
        <rect x="56" y="56" width="26" height="26" style="fill: var(--accent)" />
      </g>
    )
  }
  {
    variant === 2 && (
      <g fill="none" style="stroke: var(--accent)">
        <circle cx="0" cy="0" r="150" stroke-width="1.5" opacity="0.9" />
        <circle cx="0" cy="0" r="260" stroke-width="1.5" opacity="0.7" />
        <circle cx="0" cy="0" r="370" stroke-width="1.5" opacity="0.5" />
        <circle cx="0" cy="0" r="480" stroke-width="1.5" opacity="0.35" />
        <circle cx="0" cy="0" r="590" stroke-width="1.5" opacity="0.2" />
        <circle cx="640" cy="360" r="86" style="fill: var(--accent)" stroke="none" opacity="0.9" />
      </g>
    )
  }
  {
    variant === 3 && (
      <g>
        <rect x="0" y="0" width="800" height="500" fill={`url(#${dotsId})`} />
        <rect x="80" y="90" width="300" height="320" style="fill: var(--surface)" opacity="0.9" />
        <rect x="80" y="90" width="300" height="320" style="stroke: var(--accent)" stroke-width="1.5" fill="none" />
        <rect x="260" y="200" width="300" height="220" style="fill: var(--accent)" opacity="0.9" />
      </g>
    )
  }
  <text
    x="772"
    y="468"
    text-anchor="end"
    font-size="320"
    font-weight="600"
    style="fill: var(--ink); font-family: var(--font-display)"
    opacity="0.13"
  >
    {glyph}
  </text>
  <text
    x="40"
    y="452"
    font-size="15"
    letter-spacing="2"
    style="fill: var(--muted); font-family: var(--font-code)"
  >
    {label}
  </text>
</svg>
