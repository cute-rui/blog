---
import type { Page } from 'astro';
import type { Post } from '../lib/posts';

type Props = {
  page: Page<Post>;
};

const { page } = Astro.props;
const button =
  'inline-flex items-center gap-2 rounded-full border px-4 py-2 font-mono text-xs tracking-wide transition-colors';
---

{
  page.lastPage > 1 && (
    <nav aria-label="分页" class="flex items-center justify-between gap-4">
      {page.url.prev ? (
        <a href={page.url.prev} class:list={[button, 'border-line text-ink hover:border-accent hover:text-accent']}>
          <span aria-hidden="true">←</span>
          上一页
        </a>
      ) : (
        <span class:list={[button, 'border-line-soft text-muted/60']} aria-disabled="true">
          <span aria-hidden="true">←</span>
          上一页
        </span>
      )}
      <span class="kicker tabular-nums">
        {page.currentPage} / {page.lastPage}
      </span>
      {page.url.next ? (
        <a href={page.url.next} class:list={[button, 'border-line text-ink hover:border-accent hover:text-accent']}>
          下一页
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class:list={[button, 'border-line-soft text-muted/60']} aria-disabled="true">
          下一页
          <span aria-hidden="true">→</span>
        </span>
      )}
    </nav>
  )
}
