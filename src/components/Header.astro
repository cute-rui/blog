---
import { siteConfig } from '../site.config';
import Seal from './Seal.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<header class="sticky top-0 z-30 border-b border-line/70 bg-canvas/80 backdrop-blur-md">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-5 focus:top-3 focus:z-20 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:text-sm focus:text-ink"
  >
    跳到主内容
  </a>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-5 sm:gap-4 sm:px-8">
    <a href="/" class="group flex min-w-0 items-center gap-3">
      <Seal size={28} class="transition-transform duration-300 group-hover:scale-105" />
      <span class="truncate font-serif text-lg font-semibold tracking-tight">{siteConfig.title}</span>
    </a>
    <div class="flex shrink-0 items-center gap-2 sm:gap-4">
      <nav aria-label="主导航" class="flex items-center sm:gap-1">
        {
          siteConfig.nav.map(({ label, href }) => {
            const current = path === href || path.startsWith(href);
            return (
              <a
                href={href}
                class:list={[
                  'whitespace-nowrap rounded-full px-2 py-1.5 text-sm transition-colors sm:px-3',
                  current
                    ? 'bg-surface font-medium text-ink shadow-[inset_0_0_0_1px_var(--line)]'
                    : 'text-muted hover:bg-surface/70 hover:text-ink',
                ]}
                aria-current={current ? 'page' : undefined}
              >
                {label}
              </a>
            );
          })
        }
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
