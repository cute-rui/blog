---
import type { MarkdownHeading } from 'astro';
import { tocHeadings } from '../lib/headings';

type Props = {
  headings: MarkdownHeading[];
};

type TocDepth = 2 | 3;

const indent = { 2: 'pl-3', 3: 'pl-7' } as const;
const items = tocHeadings(Astro.props.headings);
---

{
  items.length >= 2 && (
    <nav aria-label="目录" class="text-sm" data-toc>
      <p class="kicker">目录</p>
      <ol class="mt-3 border-l border-line">
        {items.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class:list={[
                '-ml-px block border-l-2 border-transparent py-1 leading-snug text-muted transition-colors hover:text-ink',
                'aria-[current=true]:border-accent aria-[current=true]:text-ink',
                indent[heading.depth as TocDepth],
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  // Highlights the heading currently at the top of the viewport. Progressive enhancement only.
  for (const toc of document.querySelectorAll<HTMLElement>('[data-toc]')) {
    const links = new Map<HTMLElement, HTMLAnchorElement>();
    for (const link of toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (heading) links.set(heading, link);
    }
    const headings = [...links.keys()];
    if (headings.length === 0) continue;

    let active: HTMLAnchorElement | undefined;
    const update = () => {
      const cutoff = window.scrollY + 112;
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top + window.scrollY <= cutoff) current = heading;
        else break;
      }
      const link = links.get(current);
      if (link === active) return;
      active?.removeAttribute('aria-current');
      link?.setAttribute('aria-current', 'true');
      active = link;
    };

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
