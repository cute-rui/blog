---
type Props = {
  kicker?: string;
  title: string;
  meta?: string;
  description?: string;
};

const { kicker, title, meta, description } = Astro.props;
---

<header class="border-b border-line pb-6">
  {kicker && <p class="kicker text-accent">{kicker}</p>}
  <div class="mt-2 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <h1 class="font-serif text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
    {meta && <p class="kicker">{meta}</p>}
  </div>
  {description && <p class="mt-4 max-w-xl leading-relaxed text-muted">{description}</p>}
</header>
