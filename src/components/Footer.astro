---
import { siteConfig } from '../site.config';
import Seal from './Seal.astro';

const year = new Date().getFullYear();

function isExternal(href: string): boolean {
  return href.startsWith('https://') || href.startsWith('http://');
}
---

<footer class="mt-auto border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-12">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <a href="/" class="inline-flex items-center gap-3">
          <Seal size={32} />
          <span class="font-serif text-lg font-semibold tracking-tight">{siteConfig.title}</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-muted">{siteConfig.description}</p>
      </div>
      <div class="grid grid-cols-2 gap-10 sm:gap-16">
        <div>
          <p class="kicker">栏目</p>
          <ul class="mt-3 space-y-2">
            {
              siteConfig.nav.map(({ label, href }) => (
                <li>
                  <a href={href} class="text-sm text-muted transition-colors hover:text-ink">
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="kicker">链接</p>
          <ul class="mt-3 space-y-2">
            {
              siteConfig.social.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    class="inline-flex items-center gap-1 text-sm text-muted transition-colors hover:text-ink"
                    rel={isExternal(href) ? 'noopener' : undefined}
                    target={isExternal(href) ? '_blank' : undefined}
                  >
                    {label}
                    {isExternal(href) && <span aria-hidden="true">↗</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-line-soft pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="kicker">© {year} {siteConfig.author}</p>
      <p class="kicker">Astro 7 · Tailwind CSS 4 · 纯静态</p>
    </div>
  </div>
</footer>
