---
import { siteConfig } from '../site.config';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** narrow: prose pages · wide: article + TOC · full: listing + sidebar */
  width?: 'narrow' | 'wide' | 'full';
};

const { width = 'narrow', ...head } = Astro.props;
const widths = {
  narrow: 'max-w-3xl',
  wide: 'max-w-5xl',
  full: 'max-w-6xl',
} as const;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <BaseHead {...head} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class:list={['mx-auto w-full flex-1 px-5 pb-16 pt-10 sm:px-8 sm:pt-14', widths[width]]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
