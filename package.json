{
  "name": "blog",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint:content": "node scripts/lint-content.mjs",
    "md2wx:build": "cargo +stable build --release --manifest-path md2wx/Cargo.toml",
    "test:md2wx": "cargo +stable test --manifest-path md2wx/Cargo.toml",
    "test:wx": "node --test scripts/content.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.11",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "ajv": "^8.20.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
